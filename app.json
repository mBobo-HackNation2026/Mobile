{
  "expo": {
    "name": "eBobo",
    "slug": "ebobo",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "ebobo",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pl.hackathon.mojplanrodzica"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F3F3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "pl.hackathon.mojplanrodzica"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F5F8F9"
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#1B6B75"
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "eBobo używa lokalizacji, żeby pokazać ośrodki w Twojej okolicy (DEMO)."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiMode": "rest",
      "apiUrl": "https://3a21-185-174-155-52.ngrok-free.app",
      "apiBaseUrl": "https://3a21-185-174-155-52.ngrok-free.app"
    }
  }
}

# mock = lokalne fixtures (hub świadczeń / rozszerzenia)
# rest = FastAPI (eligibility/check wymaga działającego API)
EXPO_PUBLIC_API_MODE=rest
# Preferowane:
EXPO_PUBLIC_API_URL=https://YOUR-NGROK.ngrok-free.app
# Alias (wsteczna kompatybilność):
EXPO_PUBLIC_API_BASE_URL=https://YOUR-NGROK.ngrok-free.app

# OpenRouter — Node/scripts only (never EXPO_PUBLIC_*; never commit the key)
# Create at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional model slug: https://openrouter.ai/models
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_MODEL=anthropic/claude-opus-5.5
